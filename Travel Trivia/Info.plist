<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Multipeer Connectivity: iOS requires declaring the Bonjour service
	     and a local-network usage string before peers can see each other. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_travel-trivia._tcp</string>
		<string>_travel-trivia._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Travel Trivia connects to the other phones in your car to run the party — no internet needed.</string>

	<!-- OAuth (Google, via Supabase Auth) redirects back into the app on
	     this custom scheme once the provider handshake finishes. Must match
	     AuthManager.redirectURL and the Supabase project's Auth > URL
	     Configuration > Redirect URLs allow-list. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.blakesthingamajigs.travel-trivia</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.blakesthingamajigs.Travel-Trivia.oauth</string>
		</dict>
	</array>

	<!-- Export compliance: the app only uses SHA256 nonce hashing (Sign in
	     with Apple, AuthManager.sha256) and standard HTTPS/TLS (Supabase) —
	     both exempt. Declaring this here skips the manual export-compliance
	     prompt App Store Connect would otherwise ask on every build upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
